# Optional server-side API proxy target. Defaults to localhost:8000 in
# development and https://effecom-backend.onrender.com in production.
# EFFECOM_BACKEND_URL=http://localhost:8000

# Public Django origin used only for ticket-authorized, direct video uploads.
NEXT_PUBLIC_EFFECOM_BACKEND_URL=http://localhost:8000
# Keep the upload limits and extension list in sync with the Django environment.
NEXT_PUBLIC_CAPTION_MAX_UPLOAD_MB=250
NEXT_PUBLIC_CAPTION_ALLOWED_VIDEO_EXTENSIONS=mp4,mov,mkv,webm
